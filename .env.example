# --- ParentBot's own identity ---
PBOT_TOKEN=123456:ABC-your-parentbot-token
PBOT_USERNAME=YourParentBotUsername

# REQUIRED. Your numeric Telegram user id(s), comma-separated. ParentBot is
# owner-only by definition and refuses to start with this empty -- unlike the
# other four bots, where an empty admin list just disables the admin commands.
# Get your id from e.g. @userinfobot.
PBOT_ADMIN_ID=

# --- the shared family database ---
# ONE Postgres for the whole family, one schema per bot.
# ParentBot is the only process that reads across schemas. Everything that
# binds a bot to a place is this single line: point it at the cloud and the
# bot runs in the cloud, point it back at localhost and it runs here.
#
# Supabase (the family's cloud database). Copy the SESSION POOLER string
# from Project Settings -> Database -- the one on port 5432:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
#   NOT the transaction pooler on port 6543. This bot passes its
#   search_path as a connection option, and transaction pooling throws
#   per-connection options away between transactions -- the bot would read
#   and write "public" instead of its own schema and go on heartbeating as
#   if nothing were wrong. db.py warns at startup if it sees port 6543.
#
#   NOT the direct connection (db.<ref>.supabase.co) either, unless you
#   know you have IPv6: Supabase made that one IPv6-only.
#
#   PERCENT-ENCODE the password if it contains @ : / ? # or a space
#   (@ -> %40, : -> %3A, / -> %2F, # -> %23, space -> %20). An unencoded
#   "@" splits the URL in the wrong place, and the error you get names a
#   hostname you have never heard of instead of saying "bad password".
#   And if it contains "#", quote the whole value here -- python-dotenv
#   treats an unquoted # as the start of a comment.
#
# Local dev: docker compose up -d in the REPO ROOT (one Postgres for the
# whole family), or in this folder for a standalone one.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/botfamily
#
# Only run a given bot in ONE place at a time. Two processes polling
# getUpdates with the same token means Telegram answers one of them with
# 409 Conflict; stop it here before you start it there.

# ParentBot's own schema inside that database.
DB_SCHEMA=parent_bot

# The other end, for db_backup.ps1 / family_db.py when they move data
# between two databases. Same session-pooler string as above when the cloud
# copy is Supabase.
# CLOUD_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- who ParentBot watches ---
# id:DisplayName:schema, comma-separated. The ids must match each bot's own
# BOT_NAME. Only needed if you add or rename a bot -- the built-in default is
# exactly the line below.
# FAMILY_REGISTRY=stickerbot:StickerBot:sticker_bot,convertbot:ConvertBot:convert_bot,downloaderbot:DownloaderBot:downloader_bot,anonbot:AnonBot:anon_bot

# --- monitoring tuning (all optional) ---
# A bot counts as down once its heartbeat is this stale, in seconds.
# Heartbeats are sent every 30s, so the default of 120 is four missed beats.
PBOT_DOWN_AFTER_SECONDS=120
# How long a queued command waits for its target before ParentBot reports
# that bot as unreachable.
PBOT_COMMAND_TIMEOUT_SECONDS=90
# "HH:MM" UTC for a once-a-day summary DM. Empty (the default) means none --
# crashes and down/up transitions already arrive on their own.
PBOT_DIGEST_UTC=
# Seconds ParentBot waits after starting before sending the startup roll-call
# -- one message saying which of the four came up with it. The delay is what
# makes it one message instead of five; the other four write their first
# heartbeat the moment they start, so a few seconds is enough. 0 reports
# immediately.
PBOT_ROLLCALL_SECONDS=5
# A bot whose heartbeat is younger than this at roll-call time is reported as
# "just started" rather than "already up". Wording only.
PBOT_ROLLCALL_FRESH_SECONDS=120

# ---------------------------------------------------------------------------
# Running cost. Every value below has a sensible default -- this block exists
# so you know which dials there are, not because anything needs setting.
# ---------------------------------------------------------------------------

# --- the database connection pool ---
# One warm connection is held open and handed to every query; more are opened
# only while several things happen at once, and handed back after
# DB_POOL_MAX_IDLE seconds. Raising DB_POOL_MAX costs the database one
# reserved backend (and its memory) per connection, so leave it low unless
# this bot is genuinely busy.
# DB_POOL_MIN=1
# DB_POOL_MAX=3
# DB_POOL_MAX_IDLE=120
# DB_POOL_TIMEOUT=15
#
# How long a pooled connection may sit unused before it is worth a round trip
# proving it is still alive on checkout. This check used to run on EVERY
# checkout, including one half a second after the last -- a whole round trip
# to the database, which on a link to another continent was a third of the
# cost of every read. Lower it if a network in between drops idle
# connections faster than this; 0 checks every time, as it used to.
# DB_POOL_CHECK_AFTER_IDLE=45

# --- Telegram long polling ---
# Seconds to hold each getUpdates open. Higher is *cheaper*, not slower:
# Telegram answers the instant an update exists, so a longer window means
# fewer HTTP requests for identical latency. 30 is comfortably inside every
# proxy's idle timeout.
# POLL_TIMEOUT=30

# --- worker threads ---
# The pool that blocking work (database calls, ffmpeg, image processing) runs
# on. Python's default sizes itself to the *host's* core count, which on a
# shared cloud host is far more than this container's share.
# WORKER_THREADS=4

# --- active-user counting ---
# /status counts distinct users over a window, so recording each user once per
# flush window is exactly as accurate as recording every update, and writes a
# fraction as much. Rows older than the retention window are pruned by the
# housekeeping job -- they cost storage and answer nothing.
# ACTIVITY_FLUSH_SECONDS=60
# ACTIVITY_RETENTION_DAYS=90

# --- in-memory per-user state ---
# python-telegram-bot never evicts its per-user cache. Anyone idle this long
# has theirs dropped; the only thing lost is a cached language, re-read from
# the database on their next message.
# USER_DATA_TTL_HOURS=12

# --- logging ---
# Rotating bot.log/errors.log files next to bot.py. On by default locally,
# off by default on Railway -- there the filesystem is ephemeral and the
# platform already captures stdout, so the files are pure disk churn.
# LOG_TO_FILES=1

# --- the family bus (see family_link.py) ---
# FAMILY_BUS=off drops this bot back to standalone: no heartbeats, no
# ParentBot, no remote commands. Useful for isolating a problem, not as a
# permanent setting.
# FAMILY_BUS=on
# FAMILY_HEARTBEAT_SECONDS=30
# The command queue is polled, fast right after the bus was last busy
# and slow once it has gone quiet -- see family_link.py. Lower idle =
# snappier /run and /ping when nothing else is going on, at a few more
# background queries a minute.
# FAMILY_BUS_POLL_ACTIVE_SECONDS=1
# FAMILY_BUS_POLL_IDLE_SECONDS=10
# FAMILY_BUS_ACTIVE_WINDOW_SECONDS=20
# How often this bot deletes its own finished rows from the shared tables,
# and how long they are kept. family.commands carries file payloads, so this
# is the difference between a database that grows forever and one that
# doesn't.
# FAMILY_HOUSEKEEPING_SECONDS=21600
# FAMILY_COMMAND_RETENTION_HOURS=24
# FAMILY_EVENT_RETENTION_DAYS=30
# How long the usage samples are kept. One small row per bot per window, and
# the only thing here anybody will want to look *back* through, so it outlives
# the rest: 45 days is long enough to compare this month with last.
# FAMILY_USAGE_RETENTION_DAYS=45

# --- what this bot costs, over time ---
# /status says what the process is using right now, which on its own tells
# nobody whether right now is unusual. This writes one row per window into
# family.usage_samples -- updates handled, distinct people, and four numbers
# read from the kernel -- and raises an event when a window stops looking
# normal. ParentBot's /usage reads it back. Counts only: no user ids, no chat
# ids, no message text.
# USAGE_SAMPLE_MINUTES=15
#
# How full the container has to get before it is worth being told. 0.85 rather
# than 0.95 so the message arrives before the out-of-memory kill, not with it.
# USAGE_MEMORY_WARN_RATIO=0.85
#
# A window is a spike when it is this many times the median of the recent ones
# AND clears the floor. The floor is what stops "2 updates, then 12" being an
# incident on a quiet bot, which on a quiet bot is most of the time.
# USAGE_SPIKE_FACTOR=6
# USAGE_SPIKE_FLOOR=60
#
# Distinct people in 30 days, past which the owner is told once a day. Not a
# limit and nothing is refused -- it is the number that means "the smallest
# plan that fits may not be the smallest plan that fits any more".
# USAGE_MONTHLY_USERS_WARN=400
